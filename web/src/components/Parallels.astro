---
import { parallels } from "../data/profile";

// A small, deterministic gamma-ray-style curve for each field card.
const curve = (seed: number) => {
  let s = seed * 9301 + 49297;
  const r = () => ((s = (s * 9301 + 49297) % 233280) / 233280);
  const pts: string[] = [];
  let x = 30;
  for (let y = 0; y <= 120; y += 4) {
    x += (r() - 0.5) * 18;
    x = Math.max(6, Math.min(54, x));
    pts.push(`${x.toFixed(1)},${y}`);
  }
  return pts.join(" ");
};
---

<section id="parallels" class="parallels">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">01 · Method</p>
      <h2>Same instincts, different depth.</h2>
      <p>
        People ask how a geologist ended up writing backend services. The honest answer is that the
        job didn't change as much as you'd think. I still read signals from something I can't see
        into, and I still don't trust a result I haven't checked.
      </p>
    </div>

    <ol class="pairs">
      {
        parallels.map((p, i) => (
          <li class="pair">
            <div class="side field">
              <svg class="log" viewBox="0 0 60 120" preserveAspectRatio="none" aria-hidden="true">
                <line x1="30" y1="0" x2="30" y2="120" class="axis" />
                <polyline points={curve(i + 3)} />
              </svg>
              <div>
                <p class="mono label">In the field</p>
                <h3>{p.field}</h3>
                <p>{p.fieldText}</p>
              </div>
            </div>
            <div class="arrow" aria-hidden="true">→</div>
            <div class="side prod">
              <pre class="term" aria-hidden="true">{`$ ${["logcli query", "migrate --resume", "go test ./...", "erd draft"][i]}`}</pre>
              <div>
                <p class="mono label">In production</p>
                <h3>{p.prod}</h3>
                <p>{p.prodText}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .parallels {
    background: var(--bg-2);
    border-block: 1px solid var(--rule);
  }
  .pairs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }
  .pair {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    gap: 18px;
  }
  .side {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 18px;
    padding: 22px;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 14px;
  }
  .prod {
    grid-template-columns: 1fr;
  }
  .side h3 {
    font-size: 1.45rem;
    margin: 4px 0 8px;
  }
  .side p:not(.label) {
    color: var(--ink-2);
    font-size: 0.97rem;
  }
  .label {
    color: var(--ink-3);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .field h3 {
    font-style: italic;
    color: var(--ochre);
  }
  .prod h3 {
    font-family: var(--mono);
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    color: var(--moss);
  }
  .log {
    width: 60px;
    height: 100%;
    min-height: 110px;
  }
  .log polyline {
    fill: none;
    stroke: var(--log);
    stroke-width: 1.4;
    vector-effect: non-scaling-stroke;
  }
  .log .axis {
    stroke: var(--rule);
    stroke-dasharray: 2 3;
    vector-effect: non-scaling-stroke;
  }
  .term {
    margin: 0 0 4px;
    padding: 8px 10px;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--moss);
    background: var(--bg);
    border-radius: 8px;
    border: 1px solid var(--rule);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .arrow {
    align-self: center;
    font-family: var(--mono);
    color: var(--ink-3);
    font-size: 1.3rem;
  }
  @media (max-width: 820px) {
    .pair {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .arrow {
      justify-self: center;
      transform: rotate(90deg);
    }
  }
</style>
