---
import { strata } from "../data/profile";

// Standard-ish lithology symbols, used as CSS masks so they recolour with the theme.
const svg = (body: string, w = 16, h = 16) =>
  `url("data:image/svg+xml,${encodeURIComponent(
    `<svg xmlns='http://www.w3.org/2000/svg' width='${w}' height='${h}'>${body}</svg>`,
  )}")`;

const patterns: Record<string, string> = {
  sandstone: svg("<circle cx='4' cy='4' r='1.3'/><circle cx='12' cy='12' r='1.3'/><circle cx='12' cy='5' r='0.8'/><circle cx='4' cy='12' r='0.8'/>"),
  siltstone: svg("<circle cx='4' cy='4' r='1'/><rect x='8' y='11' width='6' height='1.2'/>"),
  shale: svg("<rect x='1' y='4' width='8' height='1.2'/><rect x='9' y='12' width='6' height='1.2'/>", 16, 16),
  coal: svg("<rect width='16' height='16'/>"),
  basement: svg("<path d='M2 3 L5 8 L8 3' fill='none' stroke='black' stroke-width='1.2'/><path d='M12 10 v5 M9.5 12.5 h5' stroke='black' stroke-width='1.2'/>", 18, 18),
};
---

<section id="strata" class="strata">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">02 · Stratigraphy</p>
      <h2>My career, read like a borehole.</h2>
      <p>
        Youngest at the top, oldest at the base. Bed thickness roughly follows time spent. The wavy
        line is an unconformity: a gap in the record where one environment ended and another began.
        Mine was 2021.
      </p>
    </div>

    <ol class="column">
      {
        strata.map((s) =>
          s.weight === 0 ? (
            <li class="unconformity">
              <span class="years mono">{s.years}</span>
              <svg class="wave" viewBox="0 0 400 20" preserveAspectRatio="none" aria-hidden="true">
                <path d="M0 10 Q 12.5 0 25 10 T 50 10 T 75 10 T 100 10 T 125 10 T 150 10 T 175 10 T 200 10 T 225 10 T 250 10 T 275 10 T 300 10 T 325 10 T 350 10 T 375 10 T 400 10" />
              </svg>
              <div class="uc-text">
                <p class="mono lith">{s.lithLabel}</p>
                <h3>{s.title}</h3>
                <p class="org">{s.org}</p>
              </div>
            </li>
          ) : (
            <li class="bed" style={`--min: ${80 + s.weight * 46}px`}>
              <span class="years mono">{s.years}</span>
              <span
                class:list={["core", s.lith]}
                style={`--pat: ${patterns[s.lith]}`}
                aria-hidden="true"
              />
              <div class="body">
                <p class="mono lith">{s.lithLabel}</p>
                <h3>{s.title}</h3>
                <p class="org">{s.org}</p>
                {s.points.length > 0 && (
                  <ul>
                    {s.points.map((pt) => (
                      <li>{pt}</li>
                    ))}
                  </ul>
                )}
                {s.tags && (
                  <p class="tags">
                    {s.tags.map((t) => (
                      <span>{t}</span>
                    ))}
                  </p>
                )}
              </div>
            </li>
          ),
        )
      }
    </ol>
    <p class="td mono">TD · total depth reached. Drilling continues.</p>
  </div>
</section>

<style>
  .column {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }
  .bed,
  .unconformity {
    display: grid;
    grid-template-columns: 104px 84px 1fr;
    gap: 0 28px;
  }
  .bed {
    min-height: var(--min);
    border-bottom: 1px solid var(--rule);
  }
  .years {
    padding-top: 22px;
    color: var(--ink-3);
    text-align: right;
  }
  .core {
    position: relative;
    border-inline: 2px solid var(--ink);
    overflow: hidden;
  }
  .core::before {
    content: "";
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--lith) 16%, transparent);
  }
  .core::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--lith);
    -webkit-mask-image: var(--pat);
    mask-image: var(--pat);
  }
  .core.sandstone::before {
    background: color-mix(in srgb, var(--ochre) 30%, transparent);
  }
  .core.sandstone::after {
    background: var(--ochre);
  }
  .core.coal::after {
    background: var(--coal);
  }
  .body {
    padding: 20px 0 26px;
    max-width: 680px;
  }
  .lith {
    color: var(--ink-3);
    font-size: 0.7rem;
    margin-bottom: 6px;
  }
  h3 {
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
  }
  .org {
    color: var(--ochre);
    font-size: 0.95rem;
    margin-top: 4px;
  }
  ul {
    margin: 14px 0 0;
    padding-left: 18px;
    color: var(--ink-2);
    display: grid;
    gap: 6px;
    font-size: 0.97rem;
  }
  ul li::marker {
    color: var(--ink-3);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }
  .tags span {
    font-family: var(--mono);
    font-size: 0.72rem;
    padding: 3px 9px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--ink-2);
  }
  .unconformity {
    align-items: center;
    border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--log) 6%, transparent);
  }
  .unconformity .years {
    padding: 0;
  }
  .wave {
    width: 84px;
    height: 22px;
    overflow: visible;
  }
  .wave path {
    fill: none;
    stroke: var(--log);
    stroke-width: 2.2;
    vector-effect: non-scaling-stroke;
  }
  .uc-text {
    padding: 16px 0;
  }
  .uc-text h3 {
    font-size: 1.15rem;
  }
  .uc-text .lith {
    color: var(--log);
  }
  .td {
    margin-top: 18px;
    color: var(--ink-3);
    padding-left: calc(104px + 28px);
  }
  @media (max-width: 720px) {
    .bed,
    .unconformity {
      grid-template-columns: 40px 1fr;
      gap: 0 16px;
    }
    .years {
      grid-column: 2;
      grid-row: 1;
      text-align: left;
      padding-top: 18px;
    }
    .core,
    .wave {
      grid-column: 1;
      grid-row: 1 / span 2;
      width: 40px;
    }
    .wave {
      grid-row: 1 / span 2;
      align-self: center;
    }
    .body,
    .uc-text {
      grid-column: 2;
      padding-top: 4px;
    }
    .unconformity .years {
      padding-top: 14px;
    }
    .td {
      padding-left: 56px;
    }
  }
</style>
